#!/usr/bin/env python3
# © Mayanktaker Computers & Web Development | https://mayanktaker.com
# CLI utility for checking OpenCode Go subscription usage from terminal with JSON and CSV export support

import os
import sys
import re
import json
import argparse
import configparser
import subprocess
import urllib.parse
from datetime import datetime

# Regexes used to lift the three usage windows out of the inlined SolidJS store
_WINDOW_RE = {
    "rolling": re.compile(r'rollingUsage:\$R\[\d+\]=\{[^}]*?usagePercent:(\d+)'),
    "weekly": re.compile(r'weeklyUsage:\$R\[\d+\]=\{[^}]*?usagePercent:(\d+)'),
    "monthly": re.compile(r'monthlyUsage:\$R\[\d+\]=\{[^}]*?usagePercent:(\d+)'),
}
_RESET_RE = {
    "rolling": re.compile(r'rollingUsage:\$R\[\d+\]=\{[^}]*?resetInSec:(\d+)'),
    "weekly": re.compile(r'weeklyUsage:\$R\[\d+\]=\{[^}]*?resetInSec:(\d+)'),
    "monthly": re.compile(r'monthlyUsage:\$R\[\d+\]=\{[^}]*?resetInSec:(\d+)'),
}
_OPENAUTH_MARKERS = ("<title>OpenAuth</title>", "openauth.js.org", "/github/authorize", "/google/authorize")

# Parses command line flags and arguments
def parse_args():
    parser = argparse.ArgumentParser(description="OpenCode Go CLI Usage Tracker")
    parser.add_argument("--workspace-id", "-w", help="OpenCode Workspace ID")
    parser.add_argument("--cookie", "-c", help="OpenCode Auth Cookie")
    parser.add_argument("--json", "-j", action="store_true", help="Output raw JSON format")
    parser.add_argument("--export", "-e", nargs="?", const="~/opencode-usage.csv", help="Export usage statistics to CSV file")
    parser.add_argument("--demo", "-d", action="store_true", help="Force demo mock data")
    return parser.parse_args()

# Reads plasmoid settings from KDE config file if available
def load_kde_config():
    config_path = os.path.expanduser("~/.config/plasma-org.kde.plasma.desktop-appletsrc")
    if not os.path.exists(config_path):
        return "", ""

    ws_id, cookie = "", ""
    try:
        config = configparser.ConfigParser(strict=False)
        config.read(config_path)
        for section in config.sections():
            if "com.mayanktaker.opencodego-usage" in section or "Applets" in section:
                if config.has_option(section, "workspaceId"):
                    ws_id = config.get(section, "workspaceId")
                if config.has_option(section, "authCookie"):
                    cookie = config.get(section, "authCookie")
    except Exception:
        pass
    return ws_id, cookie

# Generates mock data for demo mode
def get_mock_data():
    return {
        "isMock": True,
        "planName": "OpenCode Go (Demo Mode)",
        "billingPeriod": "Current Month",
        "usagePercent": 73,
        "currentUsed": 3650,
        "currentLimit": 5000,
        "weekly": [
            {"label": "Mon", "value": 420, "maxValue": 1000},
            {"label": "Tue", "value": 550, "maxValue": 1000},
            {"label": "Wed", "value": 710, "maxValue": 1000},
            {"label": "Thu", "value": 640, "maxValue": 1000},
            {"label": "Fri", "value": 890, "maxValue": 1000},
            {"label": "Sat", "value": 310, "maxValue": 1000},
            {"label": "Sun", "value": 250, "maxValue": 1000}
        ]
    }

# Normalizes a pasted auth credential into a valid Cookie header value
def normalize_cookie(raw):
    val = (raw or "").strip()
    if not val:
        return ""
    # Bare iron-session seal (no cookie name) -> prefix with auth=
    if val.startswith("Fe26"):
        return "auth=" + val
    return val

# Formats a seconds countdown into a compact human-readable reset label
def format_reset(sec):
    try:
        sec = int(sec)
    except (TypeError, ValueError):
        return ""
    if sec <= 0:
        return ""
    if sec < 60:
        return f"{sec}s"
    if sec < 3600:
        return f"{round(sec / 60)}m"
    if sec < 86400:
        return f"{round(sec / 3600)}h"
    return f"{round(sec / 86400)}d"

# Extracts the rolling/weekly/monthly usage windows from the Go page HTML
def parse_go_page(html):
    windows = {}
    resets = {}
    for key, rx in _WINDOW_RE.items():
        m = rx.search(html)
        if m:
            windows[key] = int(m.group(1))
    for key, rx in _RESET_RE.items():
        m = rx.search(html)
        if m:
            resets[key] = int(m.group(1))
    if not windows:
        return None
    headline = windows.get("weekly", windows.get("monthly", windows.get("rolling", 0)))
    reset_sec = resets.get("weekly", resets.get("monthly", resets.get("rolling", 0)))
    bars = []
    for label, key in (("Rolling", "rolling"), ("Weekly", "weekly"), ("Monthly", "monthly")):
        if key in windows:
            bars.append({"label": label, "value": windows[key], "maxValue": 100, "resetLabel": format_reset(resets.get(key))})
    return {
        "isMock": False,
        "planName": "OpenCode Go",
        "billingPeriod": "Rolling / Weekly / Monthly",
        "usagePercent": headline,
        "resetLabel": format_reset(reset_sec),
        "hourly": [b for b in bars if b["label"] == "Rolling"],
        "weekly": [b for b in bars if b["label"] == "Weekly"],
        "monthly": [b for b in bars if b["label"] == "Monthly"],
    }

# Fetches the Go page via curl (Qt's QML XHR strips the Cookie header, so the plasmoid uses curl too)
def fetch_usage(workspace_id, auth_cookie):
    if not workspace_id or not auth_cookie:
        return get_mock_data()

    cookie = normalize_cookie(auth_cookie)
    if "..." in cookie or len(cookie) < 150:
        return {"isMock": True, "planName": "OpenCode Go (auth cookie looks truncated)", "usagePercent": 0, "weekly": []}

    url = f"https://opencode.ai/workspace/{urllib.parse.quote(workspace_id)}/go"
    try:
        result = subprocess.run(
            ["curl", "-sSL", "--max-time", "15",
             "-H", f"Cookie: {cookie}",
             "-H", "User-Agent: Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
             "-H", "Accept: text/html,application/xhtml+xml,application/xml;q=0.9,application/json,*/*;q=0.8",
             "-H", f"X-Workspace-Id: {workspace_id}",
             url],
            capture_output=True, text=True, timeout=20,
        )
    except FileNotFoundError:
        return {"isMock": True, "planName": "OpenCode Go (curl not installed)", "usagePercent": 0, "weekly": []}
    except subprocess.TimeoutExpired:
        return {"isMock": True, "planName": "OpenCode Go (request timed out)", "usagePercent": 0, "weekly": []}

    html = result.stdout or ""
    if any(marker in html for marker in _OPENAUTH_MARKERS):
        return {"isMock": True, "planName": "OpenCode Go (auth cookie invalid or expired)", "usagePercent": 0, "weekly": []}
    parsed = parse_go_page(html)
    if parsed:
        return parsed
    return {"isMock": True, "planName": "OpenCode Go (could not parse server response)", "usagePercent": 0, "weekly": []}

# Renders progress bar visualization for terminal output
def render_progress_bar(percent, width=30):
    filled = int(round(width * percent / 100))
    bar = "█" * filled + "░" * (width - filled)
    return f"[{bar}] {percent}%"

# Exports usage dataset to formatted CSV file
def export_csv(data, file_path):
    target_path = os.path.expanduser(file_path)
    lines = ["Category,Label,Value,Max_Quota,Percentage_Used,Resets_In"]
    for category in ("hourly", "weekly", "monthly"):
        for item in data.get(category, []):
            label = item.get("label", "N/A")
            val = item.get("value", 0)
            max_v = item.get("maxValue", 100)
            pct = round((val / max_v) * 100, 1) if max_v > 0 else 0
            lines.append(f"{category.capitalize()},{label},{val},{max_v},{pct}%,{item.get('resetLabel', '')}")

    with open(target_path, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    return target_path

# Main entry point function
def main():
    args = parse_args()
    ws_id, cookie = load_kde_config()

    if args.workspace_id:
        ws_id = args.workspace_id
    if args.cookie:
        cookie = args.cookie

    if args.demo:
        data = get_mock_data()
    else:
        data = fetch_usage(ws_id, cookie)

    if args.export:
        out_file = export_csv(data, args.export)
        print(f"\033[1;32m✅ Successfully exported usage CSV statistics to:\033[0m {out_file}")
        return

    if args.json:
        print(json.dumps(data, indent=2))
        return

    # Print formatted CLI summary
    print("\033[1;36m===========================================\033[0m")
    print(f"\033[1m📊 {data.get('planName', 'OpenCode Go')} Usage Tracker\033[0m")
    print("\033[1;36m===========================================\033[0m")
    print(f"Cycle   : {data.get('billingPeriod', 'N/A')}")
    print(f"Status  : {'Demo Mode' if data.get('isMock') else 'Live API Connected'}")
    headline = data.get('usagePercent', 0)
    reset = data.get('resetLabel', '')
    print(f"Quota   : {render_progress_bar(headline)}" + (f"  (resets in {reset})" if reset else ""))
    print("-------------------------------------------")
    for category, title in (("hourly", "Rolling Window"), ("weekly", "Weekly Window"), ("monthly", "Monthly Window")):
        items = data.get(category, [])
        if not items:
            continue
        print(f"{title}:")
        for item in items:
            val = item.get("value", 0)
            max_v = item.get("maxValue", 100)
            p = int(val / max_v * 100) if max_v > 0 else 0
            mini_bar = "■" * int(p / 10) + " " * (10 - int(p / 10))
            reset_lbl = item.get("resetLabel", "")
            print(f"  {item.get('label', 'N/A'):<8} [{mini_bar}] {p:>3}% / {max_v}" + (f"   resets in {reset_lbl}" if reset_lbl else ""))
    print("\033[1;36m===========================================\033[0m")

if __name__ == "__main__":
    main()
