#!/usr/bin/env python3
# © Mayanktaker Computers & Web Development | https://mayanktaker.com
# CLI utility for checking OpenCode Go subscription usage from terminal with JSON and CSV export support

import os
import sys
import re
import json
import argparse
import configparser
import subprocess
import urllib.parse
from datetime import datetime, timezone

# Base origin every candidate console API route is resolved against
_CONSOLE_BASE_URL = "https://opencode.ai"
# Candidate console API paths for the Go status payload, tried in order so a server-side path
# rename costs one retry instead of a hard failure. Entry 0 is the verified console route — the
# workspace id travels in the x-org-id header only; `{org}` placeholders are filled per request.
_CONSOLE_STATUS_ROUTES = (
    "/console/api",
    "/console/api/internal/orgs/{org}",
    "/console/api/orgs/{org}",
    "/console/api/v2/orgs/{org}",
    "/console/api/v1/orgs/{org}",
)
# Every candidate route ends with this suffix
_CONSOLE_STATUS_SUFFIX = "/go/status"
# curl -w marker carrying the HTTP status code after the response body (the -w CLI flag stays the workspace id)
_HTTP_STATUS_MARKER = "HTTPSTATUS:"
# Console page sent as the Referer header so the request looks same-origin
_CONSOLE_REFERER_URL = _CONSOLE_BASE_URL + "/console/{org}/go"
# Current console session cookie name; the legacy iron-session `auth` seal no longer authenticates
_SESSION_COOKIE_NAME = "__Host-console_session"
# Legacy cookie name kept for bare `Fe26.2**` seals pasted from the retired console build
_LEGACY_COOKIE_NAME = "auth"
# Minimum length of a pasted cookie VALUE (the current session token is ~39 chars)
_MIN_COOKIE_VALUE_LEN = 16
# How many times one candidate route is attempted before a 5xx is reported as unavailable
_MAX_STATUS_ATTEMPTS = 3
# HTTP 5xx band treated as transient (the live console endpoint is currently intermittent)
_SERVER_ERROR_MIN = 500
_SERVER_ERROR_MAX = 600
# Reported when every candidate console route answered 404 (the API path moved again)
_ROUTE_NOT_FOUND_REASON = "OpenCode Console API route not found — check for a widget update"
# Reported when a route kept answering 5xx after every retry
_SERVER_UNAVAILABLE_REASON = "Console API temporarily unavailable (HTTP 5xx) — retry shortly"
# Reported when the pasted cookie value is missing, truncated or too short to be a session token
_COOKIE_INVALID_REASON = "auth cookie value is truncated or too short — copy the __Host-console_session cookie value from opencode.ai"
# Workspace/org ids are validated by the console as `org_...` or `wrk_...`
_WORKSPACE_ID_RE = re.compile(r"^(org_|wrk_)")
# Markers that identify an OpenAuth login page returned instead of JSON
_OPENAUTH_MARKERS = ("<title>OpenAuth</title>", "openauth.js.org", "/github/authorize", "/google/authorize")

# Parses command line flags and arguments
def parse_args():
    parser = argparse.ArgumentParser(description="OpenCode Go CLI Usage Tracker")
    parser.add_argument("--workspace-id", "-w", help="OpenCode Console workspace/org ID (wrk_... or org_...)")
    parser.add_argument("--cookie", "-c", help="OpenCode Console cookie: the __Host-console_session value or a full Cookie header")
    parser.add_argument("--json", "-j", action="store_true", help="Output raw JSON format")
    parser.add_argument("--export", "-e", nargs="?", const="~/opencode-usage.csv", help="Export usage statistics to CSV file")
    parser.add_argument("--demo", "-d", action="store_true", help="Force demo mock data")
    return parser.parse_args()

# Reads plasmoid settings from KDE config file if available
def load_kde_config():
    config_path = os.path.expanduser("~/.config/plasma-org.kde.plasma.desktop-appletsrc")
    if not os.path.exists(config_path):
        return "", ""

    ws_id, cookie = "", ""
    try:
        config = configparser.ConfigParser(strict=False)
        config.read(config_path)
        for section in config.sections():
            if "com.mayanktaker.opencodego-usage" in section or "Applets" in section:
                if config.has_option(section, "workspaceId"):
                    ws_id = config.get(section, "workspaceId")
                if config.has_option(section, "authCookie"):
                    cookie = config.get(section, "authCookie")
    except Exception:
        pass
    return ws_id, cookie

# Generates mock data for demo mode
def get_mock_data():
    return {
        "isMock": True,
        "planName": "OpenCode Go (Demo Mode)",
        "billingPeriod": "Current Month",
        "usagePercent": 73,
        "currentUsed": 3650,
        "currentLimit": 5000,
        "resetLabel": format_reset(370800),
        "resetSeconds": {"hourly": 13500, "weekly": 370800, "monthly": 1659600},
        "weekly": [
            {"label": "Mon", "value": 420, "maxValue": 1000},
            {"label": "Tue", "value": 550, "maxValue": 1000},
            {"label": "Wed", "value": 710, "maxValue": 1000},
            {"label": "Thu", "value": 640, "maxValue": 1000},
            {"label": "Fri", "value": 890, "maxValue": 1000},
            {"label": "Sat", "value": 310, "maxValue": 1000},
            {"label": "Sun", "value": 250, "maxValue": 1000}
        ]
    }

# Normalizes a pasted console credential into a valid Cookie header value
def normalize_cookie(raw):
    val = (raw or "").strip()
    if not val:
        return ""
    # Bare legacy iron-session seal (no cookie name) -> keep the old auth cookie name
    if val.startswith("Fe26"):
        return _LEGACY_COOKIE_NAME + "=" + val
    # A whole Cookie header or a name=value pair is already usable as-is
    if "=" in val:
        return val
    # Any other bare token is the current console session cookie value
    return _SESSION_COOKIE_NAME + "=" + val

# Extracts the credential value from a Cookie header for the length sanity check
def cookie_value(cookie):
    head = (cookie or "").split(";")[0].strip()
    return head.split("=", 1)[1].strip() if "=" in head else head

# Formats a seconds countdown into a compact human-readable reset label
def format_reset(sec):
    try:
        sec = int(sec)
    except (TypeError, ValueError):
        return ""
    if sec <= 0:
        return ""
    if sec < 60:
        return f"{sec}s"
    if sec < 3600:
        return f"{round(sec / 60)}m"
    if sec < 86400:
        return f"{round(sec / 3600)}h"
    return f"{round(sec / 86400)}d"

# Coerces string or numeric money fields (BigInt serialized as string) into int
def to_int(value):
    if isinstance(value, bool) or value is None:
        return 0
    if isinstance(value, int):
        return value
    if isinstance(value, float):
        return int(value)
    if isinstance(value, str):
        try:
            return int(float(value.strip()))
        except (TypeError, ValueError):
            return 0
    return 0

# Replicates the console's round-half-up integer percentage, clamped to 0..100
def meter_percent(used_micro_cents, limit_micro_cents):
    used = to_int(used_micro_cents)
    limit = to_int(limit_micro_cents)
    if limit <= 0:
        return 0
    pct = (used * 200 + limit) // (limit * 2)
    return max(0, min(100, pct))

# Converts an ISO-8601 (or epoch seconds/milliseconds) timestamp into seconds from now
def seconds_until(value):
    if value is None or isinstance(value, bool):
        return None
    now = datetime.now(timezone.utc)
    target = None
    if isinstance(value, (int, float)):
        target = _from_epoch(float(value))
    elif isinstance(value, str):
        raw = value.strip()
        if not raw:
            return None
        # Numeric strings are treated as epoch seconds/milliseconds
        if raw.lstrip("+-").replace(".", "", 1).isdigit():
            target = _from_epoch(float(raw))
        else:
            try:
                target = datetime.fromisoformat(raw.replace("Z", "+00:00"))
            except ValueError:
                return None
            if target.tzinfo is None:
                target = target.replace(tzinfo=timezone.utc)
    if target is None:
        return None
    return max(0, int((target - now).total_seconds()))

# Converts epoch seconds or milliseconds into an aware UTC datetime
def _from_epoch(value):
    if value > 1e11:
        value = value / 1000.0
    try:
        return datetime.fromtimestamp(value, timezone.utc)
    except (OverflowError, OSError, ValueError):
        return None

# Builds the internal model for a demo/error state with a single explanatory plan name
def error_model(reason):
    return {
        "isMock": True,
        "planName": f"OpenCode Go ({reason})",
        "billingPeriod": "N/A",
        "usagePercent": 0,
        "resetLabel": "",
        "resetSeconds": {},
        "hourly": [],
        "weekly": [],
        "monthly": []
    }

# Maps the console /go/status JSON (access.meters) onto the CLI's internal usage model
def parse_console_go_status(payload):
    if not isinstance(payload, dict):
        return None
    access = payload.get("access")
    if not isinstance(access, dict):
        return None
    meters = access.get("meters")
    if not isinstance(meters, dict):
        meters = {}

    model = {
        "isMock": False,
        "planName": "OpenCode Go",
        "billingPeriod": "Rolling / Weekly / Monthly",
        "usagePercent": 0,
        "resetLabel": "",
        "resetSeconds": {},
        "startsAt": access.get("startsAt"),
        "endsAt": access.get("endsAt"),
        "cancelAtPeriodEnd": bool(access.get("cancelAtPeriodEnd")),
        "hourly": [],
        "weekly": [],
        "monthly": []
    }

    # fiveHour -> Rolling, week -> Weekly, month -> Monthly (month resets at access.endsAt)
    windows = (
        ("hourly", "Rolling", meters.get("fiveHour"), None),
        ("weekly", "Weekly", meters.get("week"), None),
        ("monthly", "Monthly", meters.get("month"), access.get("endsAt")),
    )
    for key, label, meter, fallback_reset in windows:
        if not isinstance(meter, dict):
            continue
        used = to_int(meter.get("usedMicroCents"))
        limit = to_int(meter.get("limitMicroCents"))
        pct = meter_percent(used, limit)
        reset_at = meter.get("resetsAt") or fallback_reset
        reset_sec = seconds_until(reset_at)
        # Normalize an unknown countdown to 0 so --json matches the plasmoid's model contract
        model["resetSeconds"][key] = reset_sec if reset_sec is not None else 0
        model[key] = [{
            "label": label,
            "value": pct,
            "maxValue": 100,
            "usedMicroCents": used,
            "limitMicroCents": limit,
            "resetLabel": format_reset(reset_sec)
        }]

    if not any(model[key] for key in ("hourly", "weekly", "monthly")):
        return None

    # Headline percentage follows the weekly-first convention
    headline_key = next(key for key in ("weekly", "monthly", "hourly") if model[key])
    model["usagePercent"] = model[headline_key][0]["value"]
    model["resetLabel"] = model[headline_key][0]["resetLabel"]
    return model

# Extracts the console JSON payload from a curl stdout, reporting the failure reason when unusable
def parse_curl_payload(stdout):
    text = (stdout or "").strip()
    if not text:
        return None, "empty response from server"
    try:
        payload = json.loads(text)
    except ValueError:
        if any(marker in text for marker in _OPENAUTH_MARKERS):
            return None, "auth cookie invalid or expired — copy a fresh __Host-console_session cookie value"
        return None, "could not parse server response"
    if isinstance(payload, dict):
        tag = payload.get("_tag")
        # Map the console's error tags onto the verified HTTP status semantics
        if tag == "Unauthorized":
            return None, "session expired or unauthorized (HTTP 401) — copy a fresh __Host-console_session cookie value"
        if tag == "Forbidden":
            return None, "access denied (HTTP 403) — this route is restricted to console support staff"
        if tag == "BadRequest":
            return None, "bad request (HTTP 400) — the workspace ID must be sent as the x-org-id header"
    parsed = parse_console_go_status(payload)
    if parsed is None:
        return None, "no active OpenCode Go subscription on this workspace"
    return parsed, None

# Builds the console Go status URL for a candidate route index, filling in the org placeholder
def build_status_url(workspace_id, route_index):
    org = urllib.parse.quote(workspace_id, safe="")
    # Clamp into range so both front-ends resolve a bogus index identically
    idx = min(max(route_index, 0), len(_CONSOLE_STATUS_ROUTES) - 1)
    route = _CONSOLE_STATUS_ROUTES[idx].replace("{org}", org)
    return f"{_CONSOLE_BASE_URL}{route}{_CONSOLE_STATUS_SUFFIX}"

# Splits the curl -w status marker off the captured stdout into (body, http_status)
def split_http_status(stdout):
    raw = stdout or ""
    idx = raw.rfind(_HTTP_STATUS_MARKER)
    if idx == -1:
        return raw, 0
    try:
        status = int(raw[idx + len(_HTTP_STATUS_MARKER):].strip())
    except ValueError:
        status = 0
    return raw[:idx], status

# Fetches the console Go status JSON via curl, retrying transient 5xx on the same route and
# walking the candidate routes while they 404 (Qt's QML XHR strips the Cookie header, so the plasmoid uses curl too)
def fetch_usage(workspace_id, auth_cookie):
    if not workspace_id or not auth_cookie:
        return get_mock_data()

    workspace_id = workspace_id.strip()
    if not _WORKSPACE_ID_RE.match(workspace_id):
        return error_model("workspace ID must start with wrk_ or org_")

    cookie = normalize_cookie(auth_cookie)
    # The credential VALUE (not the whole Cookie header) must look like a real token
    if "..." in cookie or len(cookie_value(cookie)) < _MIN_COOKIE_VALUE_LEN:
        return error_model(_COOKIE_INVALID_REASON)

    referer = _CONSOLE_REFERER_URL.format(org=urllib.parse.quote(workspace_id, safe=""))
    # Only a 404 (path no longer served) advances to the next candidate; 5xx retries in place,
    # while 401/403/400 and network errors are final
    for index in range(len(_CONSOLE_STATUS_ROUTES)):
        url = build_status_url(workspace_id, index)
        for attempt in range(1, _MAX_STATUS_ATTEMPTS + 1):
            try:
                result = subprocess.run(
                    ["curl", "-sSL", "--max-time", "15",
                     "-H", f"Cookie: {cookie}",
                     "-H", "User-Agent: Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
                     "-H", "Accept: application/json",
                     "-H", f"x-org-id: {workspace_id}",
                     "-H", f"Referer: {referer}",
                     "-w", _HTTP_STATUS_MARKER + "%{http_code}",
                     url],
                    capture_output=True, text=True, timeout=20,
                )
            except FileNotFoundError:
                return error_model("curl not installed")
            except subprocess.TimeoutExpired:
                return error_model("request timed out")

            body, http_status = split_http_status(result.stdout)
            # Transient server error: retry the same route, then give up with a retry hint
            if _SERVER_ERROR_MIN <= http_status < _SERVER_ERROR_MAX:
                if attempt < _MAX_STATUS_ATTEMPTS:
                    continue
                return error_model(_SERVER_UNAVAILABLE_REASON)
            # Route moved: this candidate carries no status payload, so try the next one
            if http_status == 404:
                break

            parsed, reason = parse_curl_payload(body)
            if parsed:
                return parsed
            if result.returncode != 0 and not body.strip():
                detail = (result.stderr or "").strip().splitlines()
                reason = f"curl error: {detail[-1]}" if detail else "network request failed"
            return error_model(reason)

    return error_model(_ROUTE_NOT_FOUND_REASON)

# Renders progress bar visualization for terminal output
def render_progress_bar(percent, width=30):
    filled = int(round(width * percent / 100))
    bar = "█" * filled + "░" * (width - filled)
    return f"[{bar}] {percent}%"

# Exports usage dataset to formatted CSV file
def export_csv(data, file_path):
    target_path = os.path.expanduser(file_path)
    lines = ["Category,Label,Value,Max_Quota,Percentage_Used,Resets_In"]
    for category in ("hourly", "weekly", "monthly"):
        for item in data.get(category, []):
            label = item.get("label", "N/A")
            val = item.get("value", 0)
            max_v = item.get("maxValue", 100)
            pct = round((val / max_v) * 100, 1) if max_v > 0 else 0
            lines.append(f"{category.capitalize()},{label},{val},{max_v},{pct}%,{item.get('resetLabel', '')}")

    with open(target_path, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    return target_path

# Main entry point function
def main():
    args = parse_args()
    ws_id, cookie = load_kde_config()

    if args.workspace_id:
        ws_id = args.workspace_id
    if args.cookie:
        cookie = args.cookie

    if args.demo:
        data = get_mock_data()
    else:
        data = fetch_usage(ws_id, cookie)

    if args.export:
        out_file = export_csv(data, args.export)
        print(f"\033[1;32m✅ Successfully exported usage CSV statistics to:\033[0m {out_file}")
        return

    if args.json:
        print(json.dumps(data, indent=2))
        return

    # Print formatted CLI summary
    print("\033[1;36m===========================================\033[0m")
    print(f"\033[1m📊 {data.get('planName', 'OpenCode Go')} Usage Tracker\033[0m")
    print("\033[1;36m===========================================\033[0m")
    print(f"Cycle   : {data.get('billingPeriod', 'N/A')}")
    print(f"Status  : {'Demo Mode' if data.get('isMock') else 'Live API Connected'}")
    headline = data.get('usagePercent', 0)
    reset = data.get('resetLabel', '')
    print(f"Quota   : {render_progress_bar(headline)}" + (f"  (resets in {reset})" if reset else ""))
    print("-------------------------------------------")
    for category, title in (("hourly", "Rolling Window"), ("weekly", "Weekly Window"), ("monthly", "Monthly Window")):
        items = data.get(category, [])
        if not items:
            continue
        print(f"{title}:")
        for item in items:
            val = item.get("value", 0)
            max_v = item.get("maxValue", 100)
            p = int(val / max_v * 100) if max_v > 0 else 0
            mini_bar = "■" * int(p / 10) + " " * (10 - int(p / 10))
            reset_lbl = item.get("resetLabel", "")
            print(f"  {item.get('label', 'N/A'):<8} [{mini_bar}] {p:>3}% / {max_v}" + (f"   resets in {reset_lbl}" if reset_lbl else ""))
    print("\033[1;36m===========================================\033[0m")

if __name__ == "__main__":
    main()
